# Prebuilt Gitea MCP bridge: supergateway + gitea-mcp (Python) baked in.
# Mirrors the opnsense-mcp-bridge pattern, but gitea-mcp is a Python package,
# so this image carries both Node (supergateway) and Python (gitea-mcp).
#
# supergateway runs gitea-mcp as a stdio child and bridges it to streamable-HTTP
# at :8000/mcp, requiring an inbound bearer (--oauth2Bearer $MCP_BEARER_TOKEN).
#
# Build & push (GHCR, lowercase owner):
#   docker build -f Dockerfile.bridge -t ghcr.io/longnameislong935/gitea-mcp-bridge:0.0.1 .
#   docker push ghcr.io/longnameislong935/gitea-mcp-bridge:0.0.1

FROM node:20-slim

# Python runtime + pipx, and supergateway (node). Baked at build = no runtime fetch.
RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 python3-pip pipx ca-certificates \
    && npm install -g supergateway && npm cache clean --force \
    && rm -rf /var/lib/apt/lists/*

# Install gitea-mcp from its published simple index into an isolated venv,
# exposing the `gitea-mcp` console script on PATH.
ENV PIPX_HOME=/opt/pipx \
    PIPX_BIN_DIR=/usr/local/bin \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1
RUN pipx install --pip-args "--extra-index-url https://nikitatsym.github.io/gitea-mcp/simple" gitea-mcp \
    && chmod -R a+rX /opt/pipx /usr/local/bin

USER 1000:1000
EXPOSE 8000

# gitea-mcp (stdio child) reads GITEA_URL + GITEA_TOKEN from env.
# supergateway reads MCP_BEARER_TOKEN and enforces it on inbound /mcp clients.
ENTRYPOINT ["/bin/sh", "-c", "exec supergateway \
  --stdio 'gitea-mcp' \
  --outputTransport streamableHttp \
  --stateful \
  --port 8000 \
  --streamableHttpPath /mcp \
  --oauth2Bearer \"$MCP_BEARER_TOKEN\""]
